# ClickRobot 360 — environment template. PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for local development; set in Vercel project settings for deploys.

# Supabase project URL and PUBLISHABLE (anon) key. Safe for the browser; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# DO NOT add SUPABASE_SERVICE_ROLE_KEY to this app. Privileged work goes through audited
# SECURITY DEFINER RPCs that check auth.uid() + memberships. If a future server job truly needs
# it, it must live only in server-side env (no NEXT_PUBLIC_ prefix) and be reviewed first.

# Staging-only (RLS test runner in supabase/tests). Never point these at production.
# STAGING_DB_URL=postgresql://postgres:PASSWORD@db.STAGING-REF.supabase.co:5432/postgres

# Version label of the guardian consent text reviewed by Lao counsel (e.g. consent-2026-12).
# While unset, managers can create pending parent links but cannot verify them (portal stays closed).
# CR360_GUARDIAN_CONSENT_VERSION=

# Optional: AI-drafted parent reports (server-side only; never prefix with NEXT_PUBLIC_).
# Without it, teachers use the built-in template. Children's names are removed before any AI call.
# ANTHROPIC_API_KEY=
